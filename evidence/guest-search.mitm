<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href="/"><span class="mark" aria-hidden="true"></span>Stillroom</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" aria-current="page">Catalogue</a>
        <a class="nav-button" href="/login">Sign in</a>
        
      </nav>
    </div>
  </header>
  <main class="shell main" id="main" tabindex="-1">
    <h1 class="page-title">Catalogue</h1>
    <section class="collection" id="collection" aria-labelledby="collection-heading">
      <div class="section-heading">
        <h2 id="collection-heading">Results for <span class="search-term">Roaster&#39;s</span></h2>
        <p>1 product</p>
      </div>
      <form class="filters" action="/#collection" method="get">
        <div class="filter-search">
          <label for="search">Search products</label>
          <input id="search" name="q" type="search" maxlength="100" value="Roaster&#39;s" placeholder="Coffee, carafe, filters…">
        </div>
        <div><label for="category">Category</label><select id="category" name="category">
          <option value="">All categories</option>
          <option value="coffee" selected>Coffee</option><option value="brewing">Brewing gear</option><option value="serveware">Serveware</option>
        </select></div>
        <div><label for="sort">Sort by</label><select id="sort" name="sort">
          <option value="featured">Featured</option><option value="price-asc" selected>Price, low to high</option><option value="price-desc">Price, high to low</option><option value="name">Name, A to Z</option>
        </select></div>
        <button class="button">Apply</button>
      </form>
      
      <div class="product-grid"><article class="product">
    <a class="product-image" href="/products/roasters-reserve" tabindex="-1" aria-hidden="true"><img class="" src="/assets/reserve.webp" alt="Navy coffee pouch with an orange label" width="512" height="512"></a>
    <div class="product-copy">
      <p class="category">Coffee</p>
      <h3><a href="/products/roasters-reserve">Roaster&#39;s Reserve</a></h3>
      <p class="description">A 250 g small-batch coffee with apricot and brown sugar notes.</p>
      <div class="product-bottom"><strong>€24.00</strong>
        
      </div>
    </div>
  </article></div>
      
    </section></main>
  <footer class="site-footer"><div class="shell"><span class="footer-brand">Stillroom</span><span>Coffee &amp; brewing</span></div></footer>
</body>
